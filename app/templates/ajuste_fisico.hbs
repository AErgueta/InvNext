{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="row mb-4">
    <div class="col">
        <h2 class="text-primary"><i class="bi bi-clipboard2-check"></i> Conteo Físico de Inventario</h2>
        <p class="text-muted">Registra la cantidad real encontrada en el estante. El sistema calculará y ajustará la diferencia automáticamente.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Formulario de Auditoría</h5>
            </div>
            <div class="card-body">
                <form id="form-ajuste-fisico">
                    
                    <div class="row g-3 mb-3">
                        <!-- Búsqueda de SKU con Autocompletado -->
                        <div class="col-md-6 position-relative">
                            <label class="form-label fw-bold">SKU del Artículo <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-primary"><i class="bi bi-upc-scan"></i></span>
                                <input type="text" class="form-control border-primary" id="input-busqueda-ajuste" placeholder="Buscar por SKU, Nombre o Código..." autocomplete="off" required>
                            </div>
                            <ul class="dropdown-menu w-100 shadow-lg" id="dropdown-resultados-ajuste" style="max-height: 250px; overflow-y: auto; z-index: 1050;">
                            </ul>
                            <input type="hidden" id="ajuste-sku" required>
                        </div>

                        <!-- Selector dinámico de Almacén -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Almacén <span class="text-danger">*</span></label>
                            <select class="form-select border-primary" id="ajuste-almacen" required>
                                <option value="">⏳ Cargando almacenes...</option>
                            </select>
                        </div>
                    </div>

                    <!-- NUEVA FILA DIVIDIDA EN 3 PARA INCLUIR LA FECHA DE CADUCIDAD -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Número de Lote</label>
                            <input type="text" class="form-control text-uppercase" id="ajuste-lote" placeholder="Vacío si no aplica">
                            <div class="form-text small">Obligatorio si controla lotes.</div>
                        </div>
                        
                        <!-- NUEVO CAMPO: Fecha de Caducidad -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Fecha de Caducidad</label>
                            <input type="date" class="form-control" id="ajuste-caducidad" disabled>
                            <div class="form-text small text-info" id="msg-caducidad">Ingrese lote para habilitar.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-primary">Cantidad Encontrada <span class="text-danger">*</span></label>
                            <input type="number" class="form-control border-primary" id="ajuste-cantidad" min="0" step="0.01" placeholder="¿Cuánto hay?" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Flujo de Seguimiento <span class="text-danger">*</span></label>
                        <select class="form-select border-danger" id="ajuste-flujo" required>
                            <option value="" disabled selected>⚠️ Elija una ruta obligatoriamente...</option>
                            <option value="auditoria_mensual">Auditoría Mensual / Anual</option>
                            <option value="correccion_merma">Corrección por Merma / Daño</option>
                            <option value="ingreso_sobrante">Ingreso por Sobrante Físico</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Concepto / Notas <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ajuste-concepto" placeholder="Ej. Conteo cíclico de pasillo 4" required>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2" id="btn-procesar-ajuste">
                        <i class="bi bi-save"></i> Registrar Conteo y Ajustar Stock
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/ajuste_fisico.js"></script>
{% endblock %}