{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="text-primary fw-bold mb-1"><i class="bi bi-people-fill"></i> Gestión de Usuarios</h2>
        <p class="text-muted mb-0">Control de personal, roles y asignación de cajas.</p>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-primary fw-bold" onclick="abrirModalCrear()">
            <i class="bi bi-person-plus-fill"></i> Nuevo Usuario
        </button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Sucursal</th>
                        <th>Almacén</th>
                        <th>Caja Asignada</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-usuarios">
                    <tr><td colspan="7" class="text-center py-4">Cargando usuarios...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar Usuario -->
<div class="modal fade" id="modalUsuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalUsuarioTitulo">Nuevo Usuario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="form-usuario">
                <div class="modal-body">
                    <input type="hidden" id="usuario-modo" value="crear">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre de Usuario</label>
                        <input type="text" class="form-control" id="usuario-username" required>
                    </div>
                    
                    <div class="mb-3" id="grupo-password">
                        <label class="form-label fw-bold">Contraseña</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="usuario-password">
                            <button class="btn btn-outline-secondary" type="button" id="btn-toggle-password" title="Mostrar/Ocultar contraseña">
                                <i class="bi bi-eye-slash" id="icono-password"></i>
                            </button>
                        </div>
                        <small class="text-muted">Requerida solo al crear un usuario nuevo.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Rol en el Sistema</label>
                        <select class="form-select" id="usuario-rol">
                            <option value="OPERADOR">Operador (Logística/Inventario)</option>
                            <option value="CAJERO">Cajero (Punto de Venta)</option>
                            <option value="ADMIN">Administrador Global</option>
                        </select>
                    </div>

                    <hr class="text-muted">
                    <h6 class="text-primary fw-bold mb-3">Asignación Operativa</h6>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold text-muted small">Sucursal</label>
                            <select class="form-select" id="usuario-sucursal" onchange="filtrarDependencias()">
                                <option value="">Ninguna / Global</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold text-muted small">Almacén (Operadores)</label>
                            <select class="form-select" id="usuario-almacen">
                                <option value="">Seleccione Sucursal...</option>
                            </select>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold text-muted small">Caja Asignada (Solo Cajeros)</label>
                            <select class="form-select" id="usuario-caja">
                                <option value="">Seleccione Sucursal...</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold" id="btn-guardar-usuario">Guardar Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/usuarios.js"></script>
{% endblock %}