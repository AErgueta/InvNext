{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="row mb-4">
    <div class="col">
        <h2 class="text-primary"><i class="bi bi-cash-coin"></i> Pago de Orden de Compra</h2>
        <p class="text-muted">Registra pagos totales o parciales a los proveedores.</p>
    </div>
</div>

<!-- Buscador de la OC -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Número de OC</label>
                <input type="text" class="form-control text-uppercase" id="input-busqueda-pago" placeholder="Ej. PO-2026-0808">
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" id="btn-buscar-pago">Buscar Orden</button>
            </div>
        </div>
    </div>
</div>

<!-- Contenedor del Pago (Oculto hasta buscar) -->
<div id="contenedor-pago" class="d-none">
    <div class="row">
        <!-- Panel Izquierdo: Resumen Financiero -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Estado de Cuenta</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Estado Actual:</span>
                        <span class="badge" id="badge-estado-pago">PENDIENTE</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-2 fs-5">
                        <span>Total de la Orden:</span>
                        <span class="fw-bold" id="resumen-total">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-5 text-success">
                        <span>Total Pagado:</span>
                        <span class="fw-bold" id="resumen-pagado">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-4 text-danger mt-3">
                        <span class="fw-bold">Saldo Pendiente:</span>
                        <span class="fw-bold" id="resumen-saldo">0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel Derecho: Formulario de Pago -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Registrar Nuevo Pago</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Monto a Pagar <span class="text-danger">*</span></label>
                            <input type="number" class="form-control form-control-lg text-end" id="pago-monto" min="0.01" step="0.01">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Método de Pago <span class="text-danger">*</span></label>
                            <select class="form-select form-control-lg" id="pago-metodo">
                                <option value="" disabled selected>Seleccione...</option>
                                <option value="EFECTIVO">Efectivo</option>
                                <option value="TRANSFERENCIA">Transferencia Bancaria</option>
                                <option value="CHEQUE">Cheque</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Referencia / Comprobante <span class="text-danger">*</span></label>
                            <input type="text" class="form-control text-uppercase" id="pago-referencia" placeholder="Nro de Operación, Factura o Recibo">
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-success w-100 fw-bold py-2 fs-5" id="btn-procesar-pago">
                                <i class="bi bi-check-circle"></i> Confirmar Pago
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/pagar_oc.js"></script>
{% endblock %}