{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h2 class="text-primary fw-bold mb-1"><i class="bi bi-graph-up-arrow"></i> Analítica y Reportes</h2>
        <p class="text-muted mb-0">Rendimiento de ventas, sucursales y productos.</p>
    </div>
    
    <!-- Filtro de Fechas -->
    <div class="col-md-6 text-end">
        <form id="form-filtros" class="d-flex justify-content-end align-items-center gap-2">
            <div>
                <small class="text-muted fw-bold d-block text-start">Desde</small>
                <input type="date" class="form-control border-primary" id="fecha-desde" required>
            </div>
            <div>
                <small class="text-muted fw-bold d-block text-start">Hasta</small>
                <input type="date" class="form-control border-primary" id="fecha-hasta" required>
            </div>
            <div class="align-self-end">
                <button type="submit" class="btn btn-primary fw-bold" id="btn-consultar">
                    <i class="bi bi-search"></i> Consultar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tarjetas de Resumen General -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <h6 class="text-muted fw-bold mb-1">Ingresos Totales (Neto)</h6>
                <h3 class="fw-bold text-success mb-0" id="resumen-ingresos">$ 0.00</h3>
                <small class="text-muted" id="resumen-descuentos">Descuentos: $ 0.00</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <h6 class="text-muted fw-bold mb-1">Volumen de Ventas</h6>
                <h3 class="fw-bold text-primary mb-0" id="resumen-cantidad">0</h3>
                <small class="text-muted">Tickets / Facturas emitidas</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <h6 class="text-muted fw-bold mb-1">Ticket Promedio</h6>
                <h3 class="fw-bold text-warning mb-0" id="resumen-promedio">$ 0.00</h3>
                <small class="text-muted">Gasto promedio por cliente</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Tabla: Top Artículos -->
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>Top 10 Artículos Más Vendidos</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU / Artículo</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Ingreso</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-articulos">
                            <tr><td colspan="3" class="text-center text-muted py-3">Ejecuta una consulta para ver datos.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablas: Sucursales y Cajas -->
    <div class="col-md-5 mb-4">
        <!-- Sucursales -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-shop text-primary me-2"></i>Rendimiento por Sucursal</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" id="lista-sucursales">
                    <li class="list-group-item text-center text-muted py-3">Sin datos</li>
                </ul>
            </div>
        </div>

        <!-- Cajas / Métodos de Pago -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-cash-coin text-success me-2"></i>Recaudación por Caja</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Caja / Método</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-cajas">
                            <tr><td colspan="2" class="text-center text-muted py-3">Sin datos</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/reportes.js"></script>
{% endblock %}