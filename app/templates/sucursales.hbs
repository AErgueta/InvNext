{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="text-primary fw-bold mb-1"><i class="bi bi-shop"></i> Gestión de Sucursales</h2>
        <p class="text-muted mb-0">Administración de edificios y puntos de venta principales.</p>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-primary fw-bold" onclick="abrirModalCrear()">
            <i class="bi bi-plus-lg"></i> Nueva Sucursal
        </button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-sucursales">
                    <tr><td colspan="6" class="text-center py-4">Cargando sucursales...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar Sucursal -->
<div class="modal fade" id="modalSucursal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalSucursalTitulo">Nueva Sucursal</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="form-sucursal">
                <div class="modal-body">
                    <input type="hidden" id="sucursal-modo" value="crear">
                    <input type="hidden" id="sucursal-codigo-original" value="">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Código</label>
                        <input type="text" class="form-control text-uppercase" id="sucursal-codigo" placeholder="Ej: SUC-CENTRAL" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre de Sucursal</label>
                        <input type="text" class="form-control" id="sucursal-nombre" required>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Dirección</label>
                            <input type="text" class="form-control" id="sucursal-direccion">
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Teléfono</label>
                            <input type="text" class="form-control" id="sucursal-telefono">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold" id="btn-guardar-sucursal">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/sucursales.js"></script>
{% endblock %}