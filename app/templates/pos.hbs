{% extends "layouts/main.hbs" %}

{% block contenido %}
<!-- ========================================== -->
<!-- ESTILOS ESPECÍFICOS DEL PUNTO DE VENTA     -->
<!-- ========================================== -->
<style>
    /* Animación para el destello del escáner al repetir producto */
    @keyframes flashDestello {
        0% { background-color: rgba(40, 167, 69, 0.5); }
        100% { background-color: transparent; }
    }
    .fila-destello td {
        animation: flashDestello 0.8s ease-out;
    }

    /* Hacemos el Total mucho más imponente y visible */
    #pos-total {
        font-size: 2.5rem !important;
        font-weight: 900 !important;
        color: #198754 !important; /* Verde éxito de Bootstrap */
    }
</style>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-primary"><i class="bi bi-shop"></i> Punto de Venta (POS)</h2>
            <p class="text-muted">Módulo de facturación y salida de mercadería.</p>
        </div>
    </div>

    <div class="row">
        <!-- Panel Izquierdo: Buscador y Carrito -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    
                    <!-- NUEVO: Contenedor de Búsqueda Inteligente -->
                    <div class="position-relative mb-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-primary fs-5"></i></span>
                            <input type="text" id="pos-buscador" class="form-control form-control-lg border-start-0" placeholder="Escanear código o buscar por SKU/Nombre..." autocomplete="off" autofocus>
                        </div>
                        <!-- Menú desplegable para autocompletar -->
                        <ul class="dropdown-menu w-100 shadow-lg" id="dropdown-resultados-pos" style="max-height: 300px; overflow-y: auto; font-size: 1.1rem;z-index: 1050;">
                        </ul>
                    </div>

                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle" id="tabla-carrito">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>SKU</th>
                                    <th>Artículo</th>
                                    <th style="width: 110px;">Cant.</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th style="width: 110px;">Desc.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="carrito-body">
                                <!-- Las filas se generarán dinámicamente con JavaScript -->
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                                        El carrito está vacío
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel Derecho: Formulario y Totales -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">Resumen de Venta</h5>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Cliente</label>
                        <input type="text" id="pos-cliente" class="form-control" value="Cliente Mostrador">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Documento (NIT/CI)</label>
                        <input type="text" id="pos-documento" class="form-control text-uppercase" value="S/N">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Almacén de Origen</label>
                        <select id="pos-almacen" class="form-select">
                            <option value="ALM-CENTRAL">Almacén Central</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Flujo de Seguimiento</label>
                        <select id="pos-flujo" class="form-select" required>
                            <option value="">Seleccione un flujo...</option>
                            <option value="VENTA-DIRECTA">Venta Directa Mostrador</option>
                            <option value="VENTA-DELIVERY">Venta para Envío</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Condición de Pago</label>
                        <select id="pos-condicion" class="form-select">
                            <option value="CONTADO">Al Contado</option>
                            <option value="CREDITO">Crédito</option>
                        </select>
                    </div>

                    <!-- ========================================== -->
                    <!-- NUEVA SECCIÓN: MÉTODO DE PAGO Y VUELTO     -->
                    <!-- ========================================== -->
                    <div class="mb-3 border-top pt-3">
                        <label class="form-label text-muted small fw-bold">Método de Pago</label>
                        <select class="form-select border-primary" id="pos-metodo-pago">
                            <option value="EFECTIVO">💵 Efectivo</option>
                            <option value="TARJETA">💳 Tarjeta de Crédito/Débito</option>
                            <option value="QR">📱 Pago con QR</option>
                        </select>
                    </div>

                    <div id="caja-efectivo" class="mb-3 bg-white p-3 rounded border shadow-sm">
                        <label class="form-label text-muted small fw-bold">Efectivo Recibido</label>
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-success text-white fw-bold">$</span>
                            <input type="number" class="form-control text-end fw-bold fs-5 text-success" id="pos-recibido" min="0" step="0.5" placeholder="0.00">
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 border-top pt-2">
                            <span class="fw-bold text-muted">Cambio (Vuelto):</span>
                            <span class="fw-bold text-primary fs-4" id="pos-cambio">0.00</span>
                        </div>
                    </div>

                    <div id="caja-referencia" class="mb-3 d-none bg-white p-3 rounded border shadow-sm">
                        <label class="form-label text-muted small fw-bold">N° de Comprobante / Referencia</label>
                        <input type="text" class="form-control" id="pos-referencia" placeholder="Ej. 001234567">
                        <small class="text-muted mt-1 d-block">Ingrese el código de aprobación de la tarjeta o comprobante QR.</small>
                    </div>
                    <!-- ========================================== -->

                    <hr>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-bold" id="pos-subtotal">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 align-items-center">
                        <span class="text-muted">Descuento Global:</span>
                        <input type="number" id="pos-descuento" class="form-control form-control-sm w-25 text-end" value="0" min="0" step="0.01">
                    </div>
                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <h3 class="mb-0 fw-bold">Total:</h3>
                        <h3 class="mb-0 text-success fw-bold" id="pos-total">0.00</h3>
                    </div>

                    <button id="btn-cobrar" class="btn btn-success btn-lg w-100 py-3 fw-bold" disabled>
                        <i class="bi bi-cash-coin"></i> PROCESAR COBRO
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/pos.js"></script>
{% endblock %}