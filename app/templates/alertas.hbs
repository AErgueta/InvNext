<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Alertas de Stock</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            padding: 20px; 
            color: #333;
        }
        
        /* Estilos de la tabla */
        table { 
            width: 100%; 
            margin-top: 20px; 
            border-collapse: collapse; 
            text-align: center; 
        }
        
        th, td { 
            border: 1px solid #ddd; 
            padding: 12px; 
        }
        
        th { 
            background-color: #2c3e50; 
            color: white; 
        }

        tbody tr:hover {
            background-color: #f1f1f1;
        }
        
        /* Etiquetas visuales (Badges) */
        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
            color: white;
            display: inline-block;
        }

        .badge-critico {
            background-color: #e74c3c; /* Rojo alerta */
            box-shadow: 0 0 8px rgba(231, 76, 60, 0.5);
        }

        .badge-reorden {
            background-color: #f39c12; /* Naranja/Amarillo */
        }
        
        .acciones-panel {
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        button.btn-refrescar {
            background-color: #007bff; 
            color: white; 
            border: none; 
            border-radius: 4px; 
            padding: 10px 15px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="acciones-panel">
        <h2>Radar de Abastecimiento</h2>
        <button id="btn-refrescar-alertas" class="btn-refrescar">
            🔄 Actualizar Radar
        </button>
    </div>

    <table>
        <thead>
            <tr>
                <th>SKU</th>
                <th>Estado</th>
                <th>Stock Actual</th>
                <th>Punto Reorden</th>
                <th>Stock Mínimo</th>
                <th>Faltante (Unidades)</th>
            </tr>
        </thead>
        <tbody id="cuerpo-tabla-alertas">
            <tr>
                <td colspan="6" style="padding: 30px; color: #666; font-style: italic;">
                    Cargando el radar de inventario...
                </td>
            </tr>
        </tbody>
    </table>

    <script src="/static/js/alertas.js"></script>
</body>
</html>