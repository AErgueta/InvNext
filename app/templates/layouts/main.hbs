<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvNext - ERP Central</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* Ajustes menores para la barra de navegación */
        .navbar-brand { font-weight: 700; letter-spacing: 0.5px; }
        .dropdown-menu { border: none; box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15); border-radius: 8px; }
        .dropdown-item { padding: 10px 20px; font-size: 0.95rem; }
        .dropdown-item:hover { background-color: #f8f9fa; color: #0d6efd; font-weight: 500; }
        .dropdown-item i { margin-right: 8px; color: #6c757d; }
        .nav-link { font-weight: 500; font-size: 0.95rem; }
        /* Badge unificado */
        .identity-badge { background: rgba(255, 255, 255, 0.1); border-radius: 6px; padding: 6px 12px; }
    </style>
</head>
<body class="bg-light">

    <!-- BARRA DE NAVEGACIÓN SUPERIOR (Visible globalmente) -->
    {% if mostrar_menu %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand text-primary fs-4" href="/vistas/dashboard">
                <i class="bi bi-box-fill text-white me-2"></i>Inv<span class="text-white">Next</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ms-3 gap-2">
                    
                    <li class="nav-item">
                        <a class="nav-link" href="/vistas/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    </li>

                    <!-- Módulo: Ventas -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-cart3 me-1"></i>Ventas
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/vistas/pos"><i class="bi bi-pc-display-horizontal"></i> Punto de Venta (POS)</a></li>
                        </ul>
                    </li>

                    <!-- Módulo: Inventario -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-boxes me-1"></i>Inventario
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/vistas/articulos"><i class="bi bi-journal-text"></i> Catálogo de Artículos</a></li>
                            <li><a class="dropdown-item" href="/vistas/kardex"><i class="bi bi-clipboard2-data"></i> Movimientos (Kardex)</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/vistas/ajuste-fisico"><i class="bi bi-upc-scan"></i> Conteo Físico / Ajustes</a></li>
                        </ul>
                    </li>

                    <!-- Módulo: Logística -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-truck me-1"></i>Logística
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/vistas/traspasos"><i class="bi bi-box-arrow-right"></i> Traspasos a Sucursales</a></li>
                            <li id="menu-recepcion-oc"><a class="dropdown-item text-danger" href="/vistas/recepcion-oc"><i class="bi bi-box-arrow-in-down"></i> Recepción de Compras (OC)</a></li>
                        </ul>
                    </li>

                    <!-- Módulo: Alertas y Reportes -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell me-1"></i>Alertas
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/vistas/alertas"><i class="bi bi-exclamation-triangle text-warning"></i> Alertas de Stock</a></li>
                            <li><a class="dropdown-item" href="/vistas/vencimientos"><i class="bi bi-calendar-x text-danger"></i> Control de Vencimientos</a></li>
                        </ul>
                    </li>
                </ul>

                <!-- Bloque de Identidad Unificado -->
                <div class="d-flex align-items-center">
                    <div id="user-info-badge" class="identity-badge text-end me-3 text-white" style="display: none !important; line-height: 1.2;">
                        <span class="d-block fw-bold" id="layout-username" style="font-size: 0.95rem;"></span>
                        <span class="badge bg-primary" id="layout-almacen"></span>
                        <span class="badge bg-secondary ms-1" id="layout-caja" style="display: none;"></span>
                    </div>
                    
                    <button class="btn btn-outline-danger btn-sm border-0 fw-bold" onclick="cerrarSesion()">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </button>
                </div>
            </div>
        </div>
    </nav>
    {% endif %}

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="container-fluid px-lg-5 pb-5">
        {% block contenido %}
        {% endblock %}
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- RECUPERAMOS TU SCRIPT GLOBAL DE AUTENTICACIÓN -->
    <script src="/static/js/auth.js"></script>
    
    <!-- Script unificado de Identidad y Permisos -->
    <script>
        async function cargarIdentidadGlobal() {
            const token = localStorage.getItem("erp_token");
            if (!token) {
                // Si la vista requiere menú y no hay token, lo mandamos al login
                if (document.querySelector('.navbar')) {
                    window.location.href = "/vistas/login";
                }
                return;
            }

            try {
                // Extracción rápida del token JWT
                const payloadBase64 = token.split('.')[1];
                const decodedPayload = JSON.parse(atob(payloadBase64));
                const rolUsuario = decodedPayload.rol || 'OPERADOR';

                // Consulta a la BD para obtener el perfil completo (Sucursal y Caja)
                const res = await fetch('/me', { headers: { 'Authorization': `Bearer ${token}` } });
                
                if (res.ok) {
                    const perfil = await res.json();
                    
                    const nombreUsuario = perfil.username ? perfil.username.toUpperCase() : 'USUARIO';
                    const nombreAlmacen = perfil.almacen_id || perfil.codigo_almacen || 'GLOBAL';
                    const nombreCaja = perfil.caja_id || null;
                    
                    // Inyectar datos en la barra
                    document.getElementById('layout-username').textContent = nombreUsuario;
                    document.getElementById('layout-almacen').textContent = nombreAlmacen;
                    
                    if (nombreCaja) {
                        const badgeCaja = document.getElementById('layout-caja');
                        badgeCaja.textContent = nombreCaja;
                        badgeCaja.style.display = 'inline-block';
                    }

                    document.getElementById('user-info-badge').style.setProperty('display', 'block', 'important');
                    
                    // ==========================================
                    // RBAC: CONTROL VISUAL DE ACCESOS POR ROL
                    // ==========================================
                    if (rolUsuario !== 'ADMIN') {
                        // Ocultamos módulos sensibles a cajeros/operadores
                        const menuRecepOC = document.getElementById('menu-recepcion-oc');
                        if (menuRecepOC) menuRecepOC.style.display = 'none';
                    }

                } else if (res.status === 401) {
                    cerrarSesion();
                }
            } catch (error) {
                console.error("Error al cargar la identidad:", error);
            }
        }

        function cerrarSesion() {
            localStorage.removeItem("erp_token");
            window.location.href = "/vistas/login";
        }

        document.addEventListener('DOMContentLoaded', cargarIdentidadGlobal);
    </script>

    <!-- Scripts específicos de la vista -->
    {% block scripts %}
    {% endblock %}
</body>
</html>