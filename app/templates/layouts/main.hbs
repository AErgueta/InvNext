<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvNext - Sistema de Gestión</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons (Necesario para el ícono de Salir) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <!-- BARRA DE NAVEGACIÓN SUPERIOR (Solo visible si mostrar_menu es True) -->
    {% if mostrar_menu %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/vistas/kardex">InvNext</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <!-- Tus enlaces originales -->
                    <li class="nav-item"><a class="nav-link" href="/vistas/dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/vistas/articulos">Catálogo</a></li>
                    <li class="nav-item"><a class="nav-link" href="/vistas/kardex">Kardex</a></li>
                    
                    <!-- Tus nuevos módulos de inventario -->
                    <li class="nav-item"><a class="nav-link text-warning" href="/vistas/recepcion-oc">Recepción OC</a></li>
                    <li class="nav-item"><a class="nav-link text-warning" href="/vistas/ajuste-fisico">Conteo Físico</a></li>
                    
                    <!-- Más enlaces originales -->
                    <li class="nav-item"><a class="nav-link" href="/vistas/alertas">Alertas</a></li>
                    <li class="nav-item"><a class="nav-link" href="/vistas/vencimientos">Vencimientos</a></li>

                    <!-- Enlace directo a Traspasos -->
                    <li class="nav-item"><a class="nav-link text-info" href="/vistas/traspasos">Traspasos</a></li>
                </ul>
                <div class="d-flex align-items-center">
                    <!-- Insignia del Usuario -->
                    <div id="user-info-badge" class="text-end me-3" style="display: none !important;">
                        <span class="d-block fw-bold text-light" id="layout-username" style="font-size: 0.9rem;"></span>
                        <span class="badge bg-primary" id="layout-almacen"></span>
                    </div>
                    
                    <button class="btn btn-outline-danger btn-sm" onclick="cerrarSesion()">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </button>
                </div>
            </div>
        </div>
    </nav>
    {% endif %}

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="container">
        <!-- Aquí Jinja2 inyectará el contenido de login, kardex, etc. -->
        {% block contenido %}
        {% endblock %}
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Tu script global para manejar auth.js -->
    <script src="/static/js/auth.js"></script>
    
    <!-- Script unificado para la barra de navegación -->
    <script>
        async function cargarIdentidadGlobal() {
            const token = localStorage.getItem("erp_token");
            if (!token) return;

            try {
                const res = await fetch('/me', { 
                    headers: { 'Authorization': `Bearer ${token}` } 
                });
                
                if (res.ok) {
                    const perfil = await res.json();
                    
                    const nombreUsuario = perfil.username ? perfil.username.toUpperCase() : 'USUARIO';
                    const nombreAlmacen = perfil.almacen_id || perfil.codigo_almacen || 'ADMIN';
                    
                    const spanUsuario = document.getElementById('layout-username');
                    const spanAlmacen = document.getElementById('layout-almacen');
                    const badgeInfo = document.getElementById('user-info-badge');

                    if (spanUsuario) spanUsuario.textContent = nombreUsuario;
                    if (spanAlmacen) spanAlmacen.textContent = nombreAlmacen;
                    if (badgeInfo) badgeInfo.style.setProperty('display', 'block', 'important');
                    
                } else if (res.status === 401) {
                    // Solo cerramos sesión si el token es rechazado (401 No Autorizado)
                    cerrarSesion();
                } else {
                    // Registramos otros errores (ej. 500) en consola sin expulsar al usuario
                    console.error("Error del servidor al cargar perfil:", await res.text());
                }
            } catch (error) {
                console.error("Error al cargar la identidad:", error);
            }
        }

        function cerrarSesion() {
            localStorage.removeItem("erp_token");
            window.location.href = "/vistas/login";
        }

        document.addEventListener('DOMContentLoaded', cargarIdentidadGlobal);
    </script>

    <!-- Bloque para scripts específicos de cada pantalla -->
    {% block scripts %}
    {% endblock %}
</body>
</html>