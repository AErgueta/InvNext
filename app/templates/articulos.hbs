{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam"></i> Catálogo de Artículos</h2>
    <button class="btn btn-primary fw-bold" id="btn-nuevo-articulo">
        <i class="bi bi-plus-lg"></i> Nuevo Artículo
    </button>
</div>

<!-- Tabla Principal -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="cursor: pointer;" id="th-sku" title="Clic para ordenar">
                            SKU <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th style="cursor: pointer;" id="th-nombre" title="Clic para ordenar">
                            Nombre / Descripción <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th class="text-end">Precio Venta</th>
                        <th>Controla Lotes</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-articulos">
                    <tr><td colspan="5" class="text-center py-4 text-muted">Cargando catálogo...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Modal de Edición de Artículo -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Editar Artículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-editar-articulo">
                    <input type="hidden" id="edit-sku-original">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">SKU</label>
                        <input type="text" class="form-control" id="edit-sku" disabled>
                        <div class="form-text">El SKU no se puede modificar.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre / Descripción</label>
                        <input type="text" class="form-control" id="edit-nombre" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Precio de Venta ($)</label>
                        <input type="number" step="0.01" class="form-control" id="edit-precio" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btn-guardar-cambios">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/articulos.js"></script>
{% endblock %}