{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam"></i> Catálogo de Artículos</h2>
    <button class="btn btn-primary fw-bold" id="btn-nuevo-articulo">
        <i class="bi bi-plus-lg"></i> Nuevo Artículo
    </button>
</div>

<!-- Tabla Principal -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="cursor: pointer;" id="th-sku" title="Clic para ordenar">
                            SKU <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th style="cursor: pointer;" id="th-nombre" title="Clic para ordenar">
                            Nombre / Descripción <i class="bi bi-arrow-down-up text-muted small"></i>
                        </th>
                        <th class="text-end">Precio Venta</th>
                        <th>Controla Lotes</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-articulos">
                    <tr><td colspan="5" class="text-center py-4 text-muted">Cargando catálogo...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Modal de Edición de Artículo -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Editar Artículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-editar-articulo">
                    <input type="hidden" id="edit-sku-original">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">SKU</label>
                        <input type="text" class="form-control" id="edit-sku" disabled>
                        <div class="form-text">El SKU no se puede modificar.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Código de Barras</label>
                        <input type="text" class="form-control" id="edit-barras" placeholder="Opcional">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre / Descripción</label>
                        <input type="text" class="form-control" id="edit-nombre" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Precio de Venta ($)</label>
                        <input type="number" step="0.01" class="form-control" id="edit-precio" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btn-guardar-cambios">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal de Creación de Artículo -->
<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Nuevo Artículo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-crear-articulo">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">SKU <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="crear-sku" placeholder="Ej: PROD-001" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Código de Barras</label>
                            <input type="text" class="form-control" id="crear-barras" placeholder="Opcional">
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre / Descripción <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="crear-nombre" required>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Precio Venta ($) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" id="crear-precio" value="0.00" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Controla Lotes</label>
                            <select class="form-select" id="crear-lotes">
                                <option value="true">Sí (Lógica FEFO)</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Flujo de Seguimiento <span class="text-danger">*</span></label>
                            <select class="form-select" id="crear-flujo" required>
                                <option value="" disabled selected>-- Elegir ruta --</option>
                                <option value="almacen_general">Almacén General</option>
                                <option value="cadena_frio">Cadena de Frío</option>
                                <option value="insumos_internos">Insumos Internos</option>
                            </select>
                            <div class="form-text">Asignación manual obligatoria.</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btn-guardar-nuevo">Crear Artículo</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/articulos.js"></script>
{% endblock %}