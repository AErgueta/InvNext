{% extends "layouts/main.hbs" %}

{% block contenido %}
<!-- ========================================== -->
<!-- ESTILOS DE IMPRESIÓN                       -->
<!-- ========================================== -->
<style>
    @media print {
        /* Ocultar elementos de navegación y menús */
        nav, header, aside, .sidebar, .navbar { display: none !important; }
        
        /* Ocultar botones de acción y filtros */
        .col-auto, .card.mb-4 { display: none !important; }
        
        /* Limpiar fondo para ahorrar tinta */
        body { background-color: white !important; padding: 0 !important; margin: 0 !important; }
        .card { border: none !important; box-shadow: none !important; }
        
        /* Forzar que la tabla ocupe toda la hoja y respete los colores de fila */
        .table { width: 100% !important; }
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
</style>

<div class="row mb-4 align-items-center">
    <div class="col">
        <h2 class="mb-0">Kardex de Inventario (Detalle por Artículo)</h2>
        <p class="text-muted">Consulta movimientos, ingresos, egresos y saldos valorizados</p>
    </div>
    <!-- Botón para disparar el modal -->
    <div class="col-auto">
        <button class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoIngreso">
            ➕ Nuevo Ingreso
        </button>
        <button class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#modalEgreso">
            <i class="bi bi-box-arrow-right"></i> ➖ Nueva Salida
        </button>
    </div>
</div>

<!-- Filtros de Consulta -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            
            <!-- NUEVO: Búsqueda Inteligente (Reemplaza al input-sku anterior) -->
            <div class="col-md-3 position-relative">
                <label for="input-busqueda" class="form-label">Buscar Artículo</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                    <input type="text" class="form-control" id="input-busqueda" placeholder="SKU, Código o Nombre..." autocomplete="off">
                </div>
                <!-- Menú desplegable para autocompletar -->
                <ul class="dropdown-menu w-100 shadow-lg" id="dropdown-resultados" style="max-height: 250px; overflow-y: auto;">
                </ul>
                <!-- Input oculto que mantiene la lógica actual de tu JS intacta -->
                <input type="hidden" id="input-sku">
            </div>

            <!-- El resto de los filtros se mantienen igual -->
            <div class="col-md-2">
                <label for="fecha-inicio" class="form-label">Fecha Inicio</label>
                <input type="date" class="form-control" id="fecha-inicio">
            </div>
            <div class="col-md-2">
                <label for="fecha-fin" class="form-label">Fecha Fin</label>
                <input type="date" class="form-control" id="fecha-fin">
            </div>
            <div class="col-md-2">
                <label for="filtro_almacen" class="form-label">Almacén (Opcional)</label>
                <input type="text" class="form-control" id="filtro_almacen" placeholder="Código">
            </div>
            
            <!-- Botones de Acción -->
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary w-100" id="btn-consultar-kardex" style="font-size: 0.9rem;">Consultar</button>
                <button class="btn btn-outline-success w-100" id="btn-descargar-kardex" title="Exportar CSV" style="font-size: 0.9rem;">Exportar</button>
                <button class="btn btn-outline-secondary w-100" onclick="window.print()" title="Imprimir Kardex" style="font-size: 0.9rem;">
                    Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                <thead class="table-light">
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Concepto</th>
                        <th>Lote</th>
                        <th>Tipo</th>
                        <th>Costo Unit.</th>
                        <th>Ingreso</th>
                        <th>Egreso</th>
                        <th>Saldo Cant.</th>
                        <th>Saldo Dinero</th>
                    </tr>
                </thead>
                <tbody id="cuerpo-tabla-kardex">
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Ingresa un SKU y presiona "Consultar" para ver el kardex.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL PARA NUEVO INGRESO MANUAL            -->
<!-- ========================================== -->
<div class="modal fade" id="modalNuevoIngreso" tabindex="-1" aria-labelledby="modalIngresoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalIngresoLabel">➕ Registrar Nuevo Ingreso</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="form-nuevo-ingreso">
                    
                    <!-- Sección 1: Logística -->
                    <div class="p-3 mb-3 bg-light border rounded">
                        <h6 class="text-success mb-3"><i class="bi bi-box-seam"></i> Datos Logísticos</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">SKU del Artículo *</label>
                                <input type="text" class="form-control" id="ingreso-sku" required placeholder="Ej. TIN-MAG">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Almacén Destino *</label>
                                <input type="text" class="form-control" id="ingreso-almacen" required placeholder="Ej. ALM-CENTRAL">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Número de Lote</label>
                                <input type="text" class="form-control" id="ingreso-lote" placeholder="Autogenerado si vacío">
                            </div>
                        </div>
                    </div>

                    <!-- Sección 2: Finanzas y Trazabilidad -->
                    <div class="p-3 mb-3 border rounded">
                        <h6 class="text-primary mb-3"><i class="bi bi-currency-dollar"></i> Finanzas y Trazabilidad</h6>
                        <div class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Cantidad *</label>
                                <input type="number" class="form-control" id="ingreso-cantidad" min="1" step="0.01" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Costo Unit. ($) *</label>
                                <input type="number" class="form-control" id="ingreso-costo" min="0.01" step="0.01" required>
                            </div>
                            <div class="col-md-4 text-end mt-4">
                                <span class="text-muted small d-block">Valor Total a Ingresar:</span>
                                <span class="fs-5 fw-bold text-primary" id="ingreso-total-calculado">$0.00</span>
                            </div>

                            <!-- Flujo de Trabajo (Obligatorio y Manual) -->
                            <div class="col-12 mt-3">
                                <label class="form-label fw-bold">Flujo de Seguimiento *</label>
                                <select class="form-select border-primary" id="ingreso-flujo" required>
                                    <option value="" selected disabled>-- Selecciona la ruta de seguimiento --</option>
                                    <option value="FLUJO-COMPRA-NACIONAL">Compra Nacional</option>
                                    <option value="FLUJO-IMPORTACION">Importación</option>
                                    <option value="FLUJO-AJUSTE-INV">Ajuste de Inventario</option>
                                    <option value="FLUJO-DEVOLUCION">Devolución de Cliente</option>
                                </select>
                                <div class="form-text text-danger">Debe seleccionar explícitamente el flujo para este ingreso.</div>
                            </div>

                            <div class="col-12 mt-3">
                                <label class="form-label">Concepto / Notas</label>
                                <textarea class="form-control" id="ingreso-concepto" rows="2" placeholder="Motivo del ingreso..."></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success px-4">Guardar Ingreso</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- ========================================== -->
<!-- MODAL PARA NUEVO EGRESO MANUAL (FEFO)      -->
<!-- ========================================== -->
<div class="modal fade" id="modalEgreso" tabindex="-1" aria-labelledby="modalEgresoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEgresoLabel"><i class="bi bi-box-arrow-right"></i> Registrar Salida de Inventario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form-egreso">
                <div class="modal-body bg-light">
                    
                    <!-- Datos fijos (SKU y Almacén) -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small mb-0">SKU Artículo</label>
                            <input type="text" class="form-control fw-bold" id="egreso-sku" readonly>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small mb-0">Almacén Origen</label>
                            <input type="text" class="form-control fw-bold" id="egreso-almacen">
                        </div>
                    </div>

                    <hr class="text-muted">

                    <!-- SELECCIÓN OBLIGATORIA DEL FLUJO -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Flujo de Seguimiento <span class="text-danger">*</span></label>
                        <select class="form-select border-danger" id="egreso-flujo" required>
                            <!-- La opción por defecto está deshabilitada, forzando la elección manual -->
                            <option value="" disabled selected>⚠️ Despliegue y elija un flujo de trabajo...</option>
                            <option value="despacho_venta">Despacho por Venta</option>
                            <option value="consumo_interno">Consumo Interno</option>
                            <option value="control_calidad">Control de Calidad</option>
                            <option value="baja_merma">Baja por Merma / Daño</option>
                        </select>
                        <div class="form-text text-danger small">Debe asignar manualmente la ruta de seguimiento.</div>
                    </div>

                    <!-- Cantidad a retirar -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cantidad a retirar <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-lg" id="egreso-cantidad" step="0.01" min="0.01" required placeholder="Ej. 15.5">
                        <div class="form-text">El sistema descontará usando el método FEFO (primeros en vencer).</div>
                    </div>

                    <!-- Concepto libre -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Concepto / Notas <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="egreso-concepto" rows="2" required placeholder="Justificación de la salida..."></textarea>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold" id="btn-procesar-egreso">
                        <i class="bi bi-check2-circle"></i> Procesar Salida
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/kardex.js"></script>
{% endblock %}