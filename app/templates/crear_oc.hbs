{% extends "layouts/main.hbs" %}

{% block contenido %}
<div class="row mb-4">
    <div class="col">
        <h2 class="text-primary"><i class="bi bi-cart-plus"></i> Nueva Orden de Compra</h2>
        <p class="text-muted">Genera un nuevo documento para solicitar mercancía al proveedor.</p>
    </div>
</div>

<div class="row">
    <!-- Panel Izquierdo: Cabecera del Documento -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Datos Generales</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Número de OC <span class="text-danger">*</span></label>
                    <input type="text" class="form-control text-uppercase" id="oc-numero" placeholder="Ej. PO-2026-0808">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Proveedor <span class="text-danger">*</span></label>
                    <select class="form-select text-uppercase" id="oc-proveedor">
                        <option value="" disabled selected>Cargando proveedores...</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Notas Adicionales</label>
                    <textarea class="form-control" id="oc-notas" rows="3" placeholder="Opcional..."></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Derecho: Detalle de Artículos -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Artículos Solicitados</h5>
            </div>
            <div class="card-body">
                <!-- Formulario Rápido de Ingreso -->
                <div class="row g-2 mb-3 align-items-end bg-light p-3 rounded">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">SKU (Ej. TIN-BLK)</label>
                        <input type="text" class="form-control text-uppercase" id="item-sku">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Cantidad</label>
                        <input type="number" class="form-control" id="item-cant" min="1" step="0.01">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Costo Unitario</label>
                        <input type="number" class="form-control" id="item-costo" min="0.01" step="0.01">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-secondary w-100 fw-bold" id="btn-agregar-item">➕ Añadir</button>
                    </div>
                </div>

                <!-- Tabla Temporal -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Costo U.</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-crear-oc">
                            <!-- Las filas se inyectarán con JS -->
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end fs-5">Total Estimado:</th>
                                <th class="text-end fs-5 text-primary" id="total-estimado">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <button class="btn btn-primary fw-bold px-4 py-2" id="btn-guardar-oc">
                        💾 Generar Orden de Compra
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/crear_oc.js"></script>
{% endblock %}