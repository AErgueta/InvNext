{% extends "layouts/main.hbs" %}

{% block contenido %}
<!-- Encabezado y Filtros -->
<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="mb-0 text-warning" style="color: #d97706 !important;">
            <i class="bi bi-calendar-x"></i> Control de Vencimientos
        </h2>
        <p class="text-muted">Monitoreo de lotes próximos a caducar (Estrategia FEFO).</p>
    </div>
    <div class="col-md-6 text-end">
        <form id="form-filtro-vencimientos" class="d-inline-flex align-items-center gap-2">
            <label for="input-dias" class="form-label mb-0 fw-bold text-nowrap">Mostrar próximos:</label>
            <div class="input-group" style="width: 150px;">
                <input type="number" class="form-control" id="input-dias" value="30" min="1" max="365">
                <span class="input-group-text">días</span>
            </div>
            <button type="submit" class="btn btn-primary shadow-sm">
                <i class="bi bi-search"></i> Filtrar
            </button>
        </form>
    </div>
</div>

<!-- Tabla de Vencimientos -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                <thead class="table-dark">
                    <tr>
                        <th class="text-start">SKU</th>
                        <th class="text-start">Número de Lote</th>
                        <th class="text-center">Stock Disponible</th>
                        <th class="text-center">Costo Unit.</th>
                        <th class="text-center">Fecha Vencimiento</th>
                        <th class="text-center">Días Restantes</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody id="cuerpo-tabla-vencimientos">
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                            Consultando lotes activos...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/vencimientos.js"></script>
{% endblock %}